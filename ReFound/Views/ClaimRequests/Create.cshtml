@model ReFound.Models.ClaimRequest

@{
    ViewData["Title"] = "Create Claim Request";
}

<h1>Submit Claim Request</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FoundItemId" class="control-label">Found Item</label>

                <select asp-for="FoundItemId"
                        asp-items="ViewBag.FoundItems"
                        class="form-control">
                    <option value="">-- Select a Found Item --</option>
                </select>

                <span asp-validation-for="FoundItemId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StudentName" class="control-label"></label>
                <input asp-for="StudentName" class="form-control" />
                <span asp-validation-for="StudentName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StudentID" class="control-label"></label>
                <input asp-for="StudentID" class="form-control" />
                <span asp-validation-for="StudentID" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ContactNumber" class="control-label"></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClaimDescription" class="control-label"></label>
                <textarea asp-for="ClaimDescription" class="form-control" rows="4"></textarea>
                <span asp-validation-for="ClaimDescription" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RequestDate" class="control-label"></label>
                <input asp-for="RequestDate"
                       class="form-control"
                       type="date"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       readonly />
                <span asp-validation-for="RequestDate" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="Status" value="Pending" />

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">
                    Submit Claim Request
                </button>

                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}