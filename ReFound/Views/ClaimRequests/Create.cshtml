@model ReFound.Models.ClaimRequest

@{
    ViewData["Title"] = "Submit Claim Request";
}

<h1>Submit Claim Request</h1>

<h4>Claim an Item</h4>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Claimant</label>
                <input type="text" class="form-control" value="@User.Identity?.Name" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="FoundItemId" class="form-label">Found Item</label>
                <select asp-for="FoundItemId" asp-items="ViewBag.FoundItems" class="form-select">
                    <option value="">-- Select an Unclaimed Item --</option>
                </select>
                <span asp-validation-for="FoundItemId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProofOfOwnership" class="form-label"></label>
                <textarea asp-for="ProofOfOwnership" class="form-control" rows="4"
                          placeholder="Describe unique marks, stickers, serial numbers, or contents inside the item..."></textarea>
                <span asp-validation-for="ProofOfOwnership" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Submit Claim" class="btn btn-success" />
                <a asp-controller="FoundItems" asp-action="Index" class="btn btn-outline-secondary ms-2">Back to Found Items</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}