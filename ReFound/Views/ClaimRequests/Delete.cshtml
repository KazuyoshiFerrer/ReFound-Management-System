
@model ReFound.Models.ClaimRequest

@{
    ViewData["Title"] = "Delete Claim Request";
}

<h1>Delete Claim Request</h1>

<h3>Are you sure you want to delete this claim request?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Claim Request ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Found Item ID</dt>
        <dd class="col-sm-9">@Model.FoundItemId</dd>

        <dt class="col-sm-3">Item Name</dt>
        <dd class="col-sm-9">@(Model.FoundItem?.ItemName ?? "Unknown Item")</dd>

        <dt class="col-sm-3">Student Name</dt>
        <dd class="col-sm-9">@Model.StudentName</dd>

        <dt class="col-sm-3">Student ID</dt>
        <dd class="col-sm-9">@Model.StudentID</dd>

        <dt class="col-sm-3">Contact Number</dt>
        <dd class="col-sm-9">@Model.ContactNumber</dd>

        <dt class="col-sm-3">Claim Description</dt>
        <dd class="col-sm-9">@Model.ClaimDescription</dd>

        <dt class="col-sm-3">Request Date</dt>
        <dd class="col-sm-9">@Model.RequestDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Delete" class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
