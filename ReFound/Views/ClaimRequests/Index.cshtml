
@model IEnumerable<ReFound.Models.ClaimRequest>

@{
    ViewData["Title"] = "Claim Requests";
}

<h1>Claim Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Claim Request</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Claim Request ID</th>
            <th>Found Item ID</th>
            <th>Item Name</th>
            <th>Student Name</th>
            <th>Student ID</th>
            <th>Request Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FoundItemId</td>
                <td>@(item.FoundItem?.ItemName ?? "Unknown Item")</td>
                <td>@item.StudentName</td>
                <td>@item.StudentID</td>
                <td>@item.RequestDate.ToShortDateString()</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
