@model IEnumerable<ReFound.Models.ClaimRequest>

@{
    ViewData["Title"] = "Claim Requests Index";
}

<h1>Claim Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<!-- Live Search Input Box -->
<input type="text" id="claimSearchBox" class="form-control mb-3"
       placeholder="Live search claims by Item ID, User ID, proof, or status - Kazuyoshi" />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FoundItemId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClaimantUserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClaimDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProofOfOwnership)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <!-- Added id="claimRows" to target table rows -->
    <tbody id="claimRows">
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FoundItemId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ClaimantUserId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ClaimDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProofOfOwnership)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<!-- Client-Side Live Search Script -->
@section Scripts {
<script>
    document.getElementById("claimSearchBox").addEventListener("input", function () {
        const text = this.value.toLowerCase();

        document.querySelectorAll("#claimRows tr").forEach(function (row) {
            // Checks FoundItemId (cell 0), ClaimantUserId (cell 1), ProofOfOwnership (cell 3), and Status (cell 4)
            const rowText = (row.cells[0].textContent + " " +
                             row.cells[1].textContent + " " +
                             row.cells[3].textContent + " " +
                             row.cells[4].textContent).toLowerCase();

            row.style.display = rowText.includes(text) ? "" : "none";
        });
    });
</script>
}